root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[Makefile]
indent_style = tab

# Zed rewrites its own settings with tabs, and the yazi files follow upstream's
# defaults; matching them keeps diffs against either source small.
[{stow/editor_zed/**.json,stow/yazi/**.toml}]
indent_style = tab
