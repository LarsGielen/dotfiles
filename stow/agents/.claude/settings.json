{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read(//projects/**)",
      "Edit(//projects/**)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(ls:*)",
      "Bash(make lint:*)",
      "Bash(make check:*)",
      "Bash(shellcheck:*)",
      "Bash(shfmt:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git commit:*)",
      "Bash(sudo:*)",
      "Bash(yay:*)",
      "Bash(pacman:*)"
    ],
    "defaultMode": "auto",
    "blockReadsOutsideWorkingDirectories": true,
    "additionalDirectories": [
      "/projects"
    ]
  },
  "sandbox": {
    "autoAllowBashIfSandboxed": false,
    "filesystem": {
      "allowWrite": [
        "/projects"
      ],
      "allowRead": [
        ".",
        "/projects"
      ]
    }
  },
  "theme": "auto"
}
