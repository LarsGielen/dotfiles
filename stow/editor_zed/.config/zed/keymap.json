[
	// Minimal keymap. settings.json sets "base_keymap": "None", which skips Zed's
	// built-in keymap entirely, so everything the UI needs has to live here.

	// Global: menus, pickers, modals
	{
		"bindings": {
			"up": "menu::SelectPrevious",
			"down": "menu::SelectNext",
			"tab": "menu::SelectNext",
			"shift-tab": "menu::SelectPrevious",
			"enter": "menu::Confirm",
			"escape": "menu::Cancel",
			"ctrl-q": "zed::Quit",
		},
	},
	{
		"context": "menu",
		"bindings": {
			"right": "menu::SelectChild",
			"left": "menu::SelectParent",
		},
	},
	{
		"context": "Picker > Editor",
		"bindings": {
			"escape": "menu::Cancel",
			"up": "menu::SelectPrevious",
			"down": "menu::SelectNext",
		},
	},
	{
		"context": "Prompt",
		"bindings": {
			"left": "menu::SelectPrevious",
			"right": "menu::SelectNext",
		},
	},

	// Workspace entry points (everything else is reachable via the command palette)
	{
		"context": "Workspace",
		"bindings": {
			"ctrl-shift-l": "command_palette::Toggle",
			"ctrl-l": "file_finder::Toggle",
			"ctrl-s": "workspace::Save",
			"ctrl-b": "workspace::ToggleRightDock",
			"ctrl-r": "projects::OpenRecent",
			"ctrl-?": "agent::ToggleFocus",
		},
	},
	{
		"context": "Pane",
		"bindings": {
			"ctrl-w": ["pane::CloseActiveItem", { "close_pinned": false }],
		},
	},

	// Editor: basic text editing
	{
		"context": "Editor",
		"bindings": {
			"escape": "editor::Cancel",
			"backspace": "editor::Backspace",
			"shift-backspace": "editor::Backspace",
			"delete": "editor::Delete",
			"tab": "editor::Tab",
			"shift-tab": "editor::Backtab",
			"ctrl-backspace": [
				"editor::DeleteToPreviousWordStart",
				{ "ignore_newlines": false, "ignore_brackets": false },
			],
			"ctrl-delete": [
				"editor::DeleteToNextWordEnd",
				{ "ignore_newlines": false, "ignore_brackets": false },
			],
			"ctrl-x": "editor::Cut",
			"ctrl-c": "editor::Copy",
			"ctrl-v": "editor::Paste",
			"ctrl-z": "editor::Undo",
			"ctrl-y": "editor::Redo",
			"ctrl-shift-z": "editor::Redo",
			"ctrl-a": "editor::SelectAll",
			"up": "editor::MoveUp",
			"down": "editor::MoveDown",
			"left": "editor::MoveLeft",
			"right": "editor::MoveRight",
			"pageup": "editor::MovePageUp",
			"pagedown": "editor::MovePageDown",
			"home": [
				"editor::MoveToBeginningOfLine",
				{ "stop_at_soft_wraps": true, "stop_at_indent": true },
			],
			"end": ["editor::MoveToEndOfLine", { "stop_at_soft_wraps": true }],
			"ctrl-left": "editor::MoveToPreviousWordStart",
			"ctrl-right": "editor::MoveToNextWordEnd",
			"ctrl-home": "editor::MoveToBeginning",
			"ctrl-end": "editor::MoveToEnd",
			"shift-up": "editor::SelectUp",
			"shift-down": "editor::SelectDown",
			"shift-left": "editor::SelectLeft",
			"shift-right": "editor::SelectRight",
			"shift-pageup": "editor::SelectPageUp",
			"shift-pagedown": "editor::SelectPageDown",
			"shift-home": [
				"editor::SelectToBeginningOfLine",
				{ "stop_at_soft_wraps": true, "stop_at_indent": true },
			],
			"shift-end": [
				"editor::SelectToEndOfLine",
				{ "stop_at_soft_wraps": true },
			],
			"ctrl-shift-left": "editor::SelectToPreviousWordStart",
			"ctrl-shift-right": "editor::SelectToNextWordEnd",
			"ctrl-shift-home": "editor::SelectToBeginning",
			"ctrl-shift-end": "editor::SelectToEnd",
		},
	},
	{
		"context": "Editor && mode == full",
		"bindings": {
			"enter": "editor::Newline",
			"shift-enter": "editor::Newline",
			"ctrl-f": "buffer_search::Deploy",
		},
	},
	{
		"context": "Editor && renaming",
		"bindings": {
			"enter": "editor::ConfirmRename",
		},
	},
	{
		"context": "Editor && showing_completions",
		"bindings": {
			"enter": "editor::ConfirmCompletion",
			"tab": "editor::ComposeCompletion",
		},
	},
	{
		"context": "Editor && showing_code_actions",
		"bindings": {
			"enter": "editor::ConfirmCodeAction",
		},
	},
	{
		"context": "Editor && (showing_code_actions || showing_completions)",
		"bindings": {
			"up": "editor::ContextMenuPrevious",
			"down": "editor::ContextMenuNext",
		},
	},
	{
		"context": "Editor && in_snippet && has_next_tabstop && !showing_completions",
		"use_key_equivalents": true,
		"bindings": {
			"tab": "editor::NextSnippetTabstop",
		},
	},
	{
		"context": "Editor && in_snippet && has_previous_tabstop && !showing_completions",
		"use_key_equivalents": true,
		"bindings": {
			"shift-tab": "editor::PreviousSnippetTabstop",
		},
	},
	{
		"context": "Markdown",
		"bindings": {
			"ctrl-c": "markdown::Copy",
		},
	},

	// Search bars
	{
		"context": "BufferSearchBar",
		"bindings": {
			"escape": "buffer_search::Dismiss",
			"enter": "search::SelectNextMatch",
			"shift-enter": "search::SelectPreviousMatch",
		},
	},
	{
		"context": "BufferSearchBar && !in_replace > Editor",
		"use_key_equivalents": true,
		"bindings": {
			"shift-enter": "search::SelectPreviousMatch",
		},
	},
	{
		"context": "ProjectSearchBar",
		"bindings": {
			"escape": "project_search::ToggleFocus",
		},
	},
	{
		"context": "ProjectSearchView",
		"bindings": {
			"escape": "project_search::ToggleFocus",
		},
	},

	// Agent
	{
		"context": "AcpThread > Editor && !use_modifier_to_send",
		"use_key_equivalents": true,
		"bindings": {
			"enter": "agent::Chat",
		},
	},
	{
		"context": "AcpThread > Editor && use_modifier_to_send",
		"use_key_equivalents": true,
		"bindings": {
			"ctrl-enter": "agent::Chat",
			"enter": "editor::Newline",
		},
	},
	{
		"context": "AgentFeedbackMessageEditor > Editor",
		"bindings": {
			"escape": "menu::Cancel",
			"enter": "menu::Confirm",
		},
	},

	// Panels
	{
		"context": "ProjectPanel",
		"bindings": {
			"left": "project_panel::CollapseSelectedEntry",
			"right": "project_panel::ExpandSelectedEntry",
			"enter": "project_panel::Rename",
			"escape": "menu::Cancel",
		},
	},
	{
		"context": "ProjectPanel && not_editing",
		"bindings": {
			"space": "project_panel::Open",
		},
	},
	{
		"context": "OutlinePanel && not_editing",
		"bindings": {
			"escape": "menu::Cancel",
			"left": "outline_panel::CollapseSelectedEntry",
			"right": "outline_panel::ExpandSelectedEntry",
			"space": "outline_panel::OpenSelectedEntry",
		},
	},

	// Git
	{
		"context": "GitPanel && ChangesList && !GitBranchSelector && !GitRepositorySelector",
		"bindings": {
			"left": "git_panel::CollapseSelectedEntry",
			"right": "git_panel::ExpandSelectedEntry",
			"up": "git_panel::PreviousEntry",
			"down": "git_panel::NextEntry",
			"enter": "menu::Confirm",
			"space": "git::ToggleStaged",
			"tab": "git_panel::FocusEditor",
			"shift-tab": "git_panel::FocusEditor",
			"escape": "git_panel::ToggleFocus",
		},
	},
	{
		"context": "GitPanel && CommitEditor",
		"use_key_equivalents": true,
		"bindings": {
			"escape": "git::Cancel",
		},
	},
	{
		"context": "CommitEditor > Editor",
		"bindings": {
			"escape": "git_panel::FocusChanges",
			"tab": "git_panel::FocusChanges",
			"shift-tab": "git_panel::FocusChanges",
			"enter": "editor::Newline",
			"ctrl-enter": "git::Commit",
		},
	},
	{
		"context": "GitCommit > Editor && mode == auto_height",
		"bindings": {
			"escape": "menu::Cancel",
			"enter": "editor::Newline",
			"ctrl-enter": "git::Commit",
		},
	},
	{
		"context": "AskPass > Editor",
		"bindings": {
			"enter": "menu::Confirm",
		},
	},

	// Terminal: pass through keys that are bound elsewhere
	{
		"context": "Terminal",
		"bindings": {
			"ctrl-shift-c": "terminal::Copy",
			"ctrl-shift-v": "terminal::Paste",
			"ctrl-b": ["terminal::SendKeystroke", "ctrl-b"],
			"ctrl-r": ["terminal::SendKeystroke", "ctrl-r"],
			"ctrl-c": ["terminal::SendKeystroke", "ctrl-c"],
			"ctrl-q": ["terminal::SendKeystroke", "ctrl-q"],
			"ctrl-w": ["terminal::SendKeystroke", "ctrl-w"],
			"up": ["terminal::SendKeystroke", "up"],
			"down": ["terminal::SendKeystroke", "down"],
			"escape": ["terminal::SendKeystroke", "escape"],
			"enter": ["terminal::SendKeystroke", "enter"],
		},
	},

	// Settings window
	{
		"context": "SettingsWindow",
		"use_key_equivalents": true,
		"bindings": {
			"ctrl-w": "workspace::CloseWindow",
			"escape": "workspace::CloseWindow",
		},
	},
]
