{
    "disableBypassPermissionsMode": "disable",
    "sandbox": {
        "enabled": true,
        "allowUnsandboxedCommands": false,
        "filesystem": {
            "denyRead": [
                "~/.ssh",
                "~/.gnupg",
                "~/.aws",
                "~/.pki",
                "~/.config/gh",
                "~/.config/rclone",
                "~/.config/git",
                "~/.config/anthropic",
                "~/.config/vivaldi",
                "~/.cache/vivaldi",
                "~/.local/share/keyrings",
                "~/gdrive",
                "~/Workspace",
                "~/.bash_history",
                "~/.zsh_history",
                "~/.claude.json",
                "~/.claude/history.jsonl",
                "~/.claude/ssh",
                "~/.claude/backups",
                "/mnt",
                "/root",
                "/etc/ssh"
            ],
            "denyWrite": [
                "~/.claude/settings.json",
                "~/.claude/settings.local.json",
                "./.claude/settings.json",
                "./.claude/settings.local.json",
                "~/dotfiles/stow/agents/.claude/settings.json"
            ]
        },
        "network": {
            "allowedDomains": [
                "github.com",
                "api.github.com",
                "raw.githubusercontent.com",
                "registry.npmjs.org",
                "pypi.org",
                "files.pythonhosted.org",
                "archlinux.org",
                "wiki.archlinux.org",
                "aur.archlinux.org"
            ]
        }
    },
    "permissions": {
        "deny": [
            "Bash(rm -rf /:*)",
            "Bash(rm -rf ~:*)",
            "Bash(git push --force:*)",
            "Edit(~/.claude/settings.json)",
            "Edit(~/.claude/settings.local.json)",
            "Edit(**/.claude/settings.json)",
            "Edit(**/.claude/settings.local.json)",
            "Edit(~/dotfiles/stow/agents/.claude/settings.json)",
            "Read(~/.ssh/**)",
            "Read(~/.gnupg/**)",
            "Read(~/.aws/**)",
            "Read(~/.pki/**)",
            "Read(~/.config/gh/**)",
            "Read(~/.config/rclone/**)",
            "Read(~/.config/git/**)",
            "Read(~/.config/anthropic/**)",
            "Read(~/.config/vivaldi/**)",
            "Read(~/.cache/vivaldi/**)",
            "Read(~/.local/share/keyrings/**)",
            "Read(~/gdrive/**)",
            "Read(~/Workspace/**)",
            "Read(~/.claude/ssh/**)",
            "Read(~/.claude/backups/**)",
            "Read(~/.bash_history*)",
            "Read(~/.zsh_history*)",
            "Read(~/.claude.json*)",
            "Read(~/.claude/history.jsonl*)",
            "Read(//mnt/**)",
            "Read(//root/**)",
            "Read(//etc/ssh/**)",
            "Read(./.env)",
            "Read(./.env.*)"
        ]
    }
}
