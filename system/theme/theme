#!/usr/bin/env bash

# Front door for the colour system, symlinked to ~/.local/bin/theme by
# modules/base/install-theme.sh.
#   theme switch              show the active palette and the available ones
#   theme switch catppuccin   switch everything to catppuccin

set -euo pipefail

THEME_DIR="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"

usage() {
    cat <<EOF
Usage: theme <command> [args]

Commands:
  switch [palette] [--dry-run]   Activate a palette, or list them with no argument
  help                           Show this help
EOF
}

case "${1:-}" in
    switch)
        shift
        exec "$THEME_DIR/switch.sh" "$@"
        ;;
    "" | help | -h | --help)
        usage
        ;;
    *)
        usage >&2
        exit 1
        ;;
esac
